# Application
NODE_ENV=development
PORT=3000
APP_NAME=Munshi
API_VERSION=v1

# Database - MySQL
DATABASE_URL="mysql://munshi_user:munshi_password@localhost:3306/munshi_db"

# Database - MongoDB
MONGODB_URI="mongodb://localhost:27017/munshi"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m
CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=info

# Email (for future implementation)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# BullMQ
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379

# Storage
STORAGE_DRIVER=local
APP_URL=http://localhost:3000

# AWS S3 (optional, only required if using S3 driver)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_REGION=us-east-1
AWS_URL=
