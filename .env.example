# Application
NODE_ENV=development
PORT=3000
APP_NAME=Munshi
API_VERSION=v1

# Database - MySQL
DATABASE_URL="mysql://munshi_user:munshi_password@localhost:3306/munshi_db"

# Database - MongoDB
MONGODB_URI="mongodb://localhost:27017/munshi"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m
CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=info

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@munshi.app

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# BullMQ (Job Queue)
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379

# Storage
STORAGE_DRIVER=local
APP_URL=http://localhost:3000

# AWS S3 (optional, only required if using S3 driver)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_REGION=us-east-1
AWS_URL=

# ============================================================
# AI INTEGRATION (NEW!)
# ============================================================

# Groq AI (FREE API - https://console.groq.com/keys)
# Get your free API key: https://console.groq.com/keys
# Free tier: 14,400 requests/day, 30 requests/minute
GROQ_API_KEY=gsk_your_groq_api_key_here

# Alternative AI Providers (Optional)
# Uncomment and use if you prefer different AI service

# OpenAI (Has free credits initially)
# OPENAI_API_KEY=sk-your-openai-key

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-key

# Google Gemini
# GOOGLE_AI_KEY=your-google-ai-key

# Hugging Face (100% Free)
# HUGGINGFACE_TOKEN=hf_your_token

# AI Configuration
AI_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2000

# OCR Configuration
OCR_LANGUAGE=eng
OCR_CONFIDENCE_THRESHOLD=0.7

# ============================================================
# PAGINATION DEFAULTS
# ============================================================

# Default items per page
DEFAULT_PAGE_SIZE=20

# Maximum items per page
MAX_PAGE_SIZE=100

# ============================================================
# BUSINESS LOGIC CONFIGURATION
# ============================================================

# Invoice numbering format
INVOICE_NUMBER_PREFIX=INV
INVOICE_NUMBER_FORMAT=YYYY-XXXX

# Default GST rate (in percentage)
DEFAULT_GST_RATE=18

# Default payment terms (in days)
DEFAULT_PAYMENT_TERMS=30

# Default credit limit
DEFAULT_CREDIT_LIMIT=0
