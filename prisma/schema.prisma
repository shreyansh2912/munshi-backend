// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────
enum UserRole {
  USER
  ADMIN
  ENTERPRISE_MEMBER
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// ──────────────────────────────────────────────────────────────
// Models
// ──────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  firstName     String
  lastName      String
  role          UserRole @default(USER)
  isActive      Boolean  @default(true)
  isMfaEnabled  Boolean  @default(false)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  refreshTokens       RefreshToken[]
  deviceFingerprints  DeviceFingerprint[]
  ledgers             Ledger[]
  transactions        Transaction[]
  invoices            Invoice[]
  auditLogs           AuditLog[]

  @@index([email])
  @@map("users")
}

// Fixed: PascalCase model name + proper composite unique constraint
model RefreshToken {
  id                String   @id @default(uuid())
  token             String   @unique @db.VarChar(1000)
  userId            String
  deviceFingerprint String
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite unique to prevent duplicate tokens per device
  @@unique([userId, deviceFingerprint])
  @@index([userId])
  @@index([token])
  @@index([expiresAt]) // useful for cleanup jobs
  @@map("refresh_tokens")
}

// Fixed: PascalCase + proper composite primary key (as intended)
model DeviceFingerprint {
  userId      String
  fingerprint  String
  userAgent   String    @db.Text
  ipAddress   String?
  lastUsedAt  DateTime  @default(now()) @updatedAt
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, fingerprint])        // composite PK – this is what you wanted!
  @@index([userId])
  @@index([lastUsedAt])
  @@map("device_fingerprints")
}

// Ledger (Chart of Accounts)
model Ledger {
  id           String  @id @default(uuid())
  userId       String
  accountCode  String
  accountName  String
  accountType  AccountType
  parentId     String?
  balance      Decimal @default(0) @db.Decimal(15, 2)
  isActive     Boolean @default(true)
  description  String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Ledger?      @relation("LedgerHierarchy", fields: [parentId], references: [id])
  children     Ledger[]     @relation("LedgerHierarchy")
  transactions Transaction[]

  @@unique([userId, accountCode])
  @@index([userId])
  @@index([accountType])
  @@map("ledgers")
}

model Transaction {
  id               String           @id @default(uuid())
  userId           String
  ledgerId         String
  transactionType  TransactionType
  amount           Decimal          @db.Decimal(15, 2)
  description      String           @db.Text
  referenceNumber  String?
  transactionDate  DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger Ledger   @relation(fields: [ledgerId], references: [id])

  @@index([userId])
  @@index([ledgerId])
  @@index([transactionDate])
  @@map("transactions")
}

model Invoice {
  id           String         @id @default(uuid())
  userId       String
  invoiceNumber String        @unique
  clientName   String
  clientEmail  String?
  clientAddress String?       @db.Text
  invoiceDate  DateTime
  dueDate      DateTime
  subtotal     Decimal        @db.Decimal(15, 2)
  taxAmount    Decimal        @default(0) @db.Decimal(15, 2)
  totalAmount  Decimal        @db.Decimal(15, 2)
  status       InvoiceStatus  @default(DRAFT)
  notes        String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       InvoiceItem[]
  gstRecords  GSTRecord[]

  @@index([userId])
  @@index([status])
  @@index([invoiceDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String  @db.Text
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  amount      Decimal @db.Decimal(15, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model GSTRecord {
  id            String    @id @default(uuid())
  userId        String
  invoiceId     String?
  gstNumber     String
  gstRate       Decimal   @db.Decimal(5, 2)
  taxableAmount Decimal   @db.Decimal(15, 2)
  gstAmount     Decimal   @db.Decimal(15, 2)
  recordDate    DateTime
  createdAt     DateTime  @default(now())

  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([userId])
  @@index([recordDate])
  @@map("gst_records")
}

model AuditLog {
  id        String    @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String
  userAgent String    @db.Text
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}